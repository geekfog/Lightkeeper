<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Test method names describe behavior with underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lightkeeper.Functions\Lightkeeper.Functions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\samples\*.json" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
